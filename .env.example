# WeatherPulse India - Environment Configuration
APP_NAME="WeatherPulse India"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL with PostGIS for production; SQLite fallback for local quick evaluation)
DATABASE_URL="sqlite:///./weatherpulse.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg://weatherpulse:weatherpulse_secret@localhost:5432/weatherpulse_db"

# Security & JWT Authentication
SECRET_KEY="weatherpulse-india-national-weather-security-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Big Data Streaming (Kafka)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC_REPORTS="weatherpulse.reports.incoming"
KAFKA_TOPIC_EVENTS="weatherpulse.events.clustered"
KAFKA_ENABLED=false

# Redis Cache & Pub/Sub
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=false

# Object Storage (MinIO / S3 for media uploads)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="weatherpulse-media"
MINIO_SECURE=false

# Live Simulator Settings
SIMULATOR_INTERVAL_SECONDS=4
SIMULATOR_AUTO_START=false
